# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
ident_size = 4

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.{json,js,ts,html,css,scss}]
indent_style = space
ident_size = 2
# my IDE/extension doesn't seem to support overriding the ident_size from [*]


[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.tsv]
indent_style = tab
indent_size = 4
